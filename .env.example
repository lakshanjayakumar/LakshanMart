# Environment Variables for LakshanMart
# Copy this file to .env and customize values for your deployment environment

# Database Configuration
DB_URL=jdbc:h2:mem:lakshanmart;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
# Server mode URL: jdbc:h2:tcp://localhost:9092/./data/lakshanmart
DB_USERNAME=sa
DB_PASSWORD=

# HikariCP Pool
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# Security & Sessions
SESSION_TIMEOUT_MINUTES=30

# AI Provider Configuration (Section 17: gemini | mock)
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=
